{
  "sourceLanguage" : "en",
  "strings" : {
    "/ %lldg" : {
      "comment" : "A label showing the current amount of a specific macronutrient in a meal, followed by a slash and the goal amount.",
      "isCommentAutoGenerated" : true
    },
    "%@ cal" : {
      "comment" : "A set of text labels displaying the nutritional information of a food item. The argument is the string “%.0f”.",
      "isCommentAutoGenerated" : true
    },
    "%@ Cal" : {
      "comment" : "A text view displaying the remaining calories to reach the daily goal. The text is formatted to show the number of calories remaining, rounded to the nearest whole number. The argument is the string “%.0f”.",
      "isCommentAutoGenerated" : true
    },
    "%@ g" : {
      "comment" : "A label displaying the amount of protein in a food item. The argument is the string “%.0f”.",
      "isCommentAutoGenerated" : true
    },
    "%@: %.1f g" : {
      "comment" : "A unit of measurement for grams. The argument is the string “KeyProtein”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$.1f g"
          }
        }
      }
    },
    "%@: %.1f kcal" : {
      "comment" : "A label displaying the calorie content of a food item, formatted to one decimal place. The argument is the calorie content of the food item, expressed as a floating-point number. The argument is the string “KeyCalorie”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$.1f kcal"
          }
        }
      }
    },
